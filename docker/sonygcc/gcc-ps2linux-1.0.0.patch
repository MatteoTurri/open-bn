+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.jason/operator.C	Mon May 24 18:22:17 1999
@@ -0,0 +1,31 @@
+// General test for operator overloading permissiveness.
+// Build don't link:
+// Special g++ Options:
+
+typedef __SIZE_TYPE__ size_t;
+
+struct A {
+  int operator?:(int a, int b);	   // WARNING - 
+  static int operator()(int a);	   // ERROR - must be nonstatic
