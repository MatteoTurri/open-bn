+
+// keywords: typedef, nested types, scope
+
+struct foo {
+	foo ();
+	typedef void (*function_p) (void);
+};
+
+function_p fp;		// ERROR - no such type in scope
+
+foo::foo () {}
+
+int main () { return 0; }
