diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.other/overcnv2.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.other/overcnv2.C
--- gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.other/overcnv2.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.other/overcnv2.C	Wed Jul  7 16:16:12 1999
@@ -0,0 +1,18 @@
+// Test that we resolve this case as mandated by the standard, but also
+// warn about it.  We choose op char* not because it is a member of B --
+// the standard says that all conversion ops are treated as coming from
+// the type of the argument -- but because it is non-const.
+
+struct A  {
+  operator const char *() const;
+};
+
+struct B : public A {
+  operator char *() { return 0; }
+};
+
+int main()
+{
+  B b;
+  (const char *)b;		// WARNING - surprising overload resolution
+}
