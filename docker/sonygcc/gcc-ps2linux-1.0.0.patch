-    /* 15.16 Multiplicative operators */
-    case MULT_EXPR:		/* 15.16.1 Multiplication Operator * */
-    case RDIV_EXPR:		/* 15.16.2 Division Operator / */
-    case TRUNC_MOD_EXPR:	/* 15.16.3 Remainder operator % */
