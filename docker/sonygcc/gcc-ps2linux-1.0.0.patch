+    uu.ti = __negti2 (uu.ti);
+  if (vv.d.high < 0)
+    c = ~c,
+    vv.ti = __negti2 (vv.ti);
+
+  w = __udivmodti4 (uu.ti, vv.ti, (UTItype *) 0);
