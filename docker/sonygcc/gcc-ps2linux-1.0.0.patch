+
+  au.ti = a, bu.ti = b;
+
+  if ((UDItype) au.d.high < (UDItype) bu.d.high)
+    return 0;
+  else if ((UDItype) au.d.high > (UDItype) bu.d.high)
+    return 2;
+  if ((UDItype) au.d.low < (UDItype) bu.d.low)
+    return 0;
+  else if ((UDItype) au.d.low > (UDItype) bu.d.low)
+    return 2;
+  return 1;
+}
+#endif
