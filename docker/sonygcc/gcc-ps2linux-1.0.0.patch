--- gcc-2.95.2/gcc/testsuite/gcc.c-torture/execute/ieee/980619-1.x	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/execute/ieee/980619-1.x	Mon May 24 18:22:21 1999
@@ -0,0 +1,11 @@
+set torture_eval_before_execute {
+
