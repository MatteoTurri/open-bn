+		if(!count) return;
+		(*count)--;
+		if(*count<=0) {
+			delete count;
+			delete object;
+			count=0;
+			object=0;
+		}
+	}
+	void inc_count() {
+		if(!count) return;
+		(*count)++;
+	}
+ public:
+	Counted() {
+		count=0;
+		object=0;
+	}
+	Counted(T *object):object(object) {
+		count = new int(1);
+	}
+	~Counted() {
+		dec_count();
+	}
+	Counted(Counted &other) {
+		count=other.count;
+		object=other.object;
+		inc_count();
+	}
+	Counted &operator=(Counted &other) {
+		other.inc_count();
+		dec_count();
+		count=other.count;
+		object=other.object;
+		return *this;
+	}
+
