-static tree
-add_stmt_to_block (b, type, stmt)
-     tree b, type, stmt;
-{
-  tree body = BLOCK_EXPR_BODY (b), c;
-  
-  if (java_error_count)
-    return body;
-    
-  if ((c = add_stmt_to_compound (body, type, stmt)) == body)
-    return body;
-
-  BLOCK_EXPR_BODY (b) = c;
-  TREE_SIDE_EFFECTS (c) = 1;
-  return c;
-}
