+LS::LS(double i_t_x, double i_t_y,
+       double i_k, double i_theta,
+       double i_centre_x, double i_centre_y) :
+  Mouvement(i_t_x, i_t_y, i_centre_x, i_centre_y),
+  k(i_k),
+  theta(i_theta)
