diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.jason/overload33.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.jason/overload33.C
