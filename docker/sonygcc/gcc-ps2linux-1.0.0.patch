-  switch (op_token)
-    {
-    case PLUS_TK: op = UNARY_PLUS_EXPR; break;
-    case MINUS_TK: op = NEGATE_EXPR; break;
-    case NEG_TK: op = TRUTH_NOT_EXPR; break;
-    case NOT_TK: op = BIT_NOT_EXPR; break;
