-/* Generate code for all context remembered for code generation.  */
-
-void
-java_expand_classes ()
-{
-  int save_error_count = 0;
-  java_parse_abort_on_error ();
-  if (!(ctxp = ctxp_for_generation))
-    return;
-  java_layout_classes ();
-  java_parse_abort_on_error ();
