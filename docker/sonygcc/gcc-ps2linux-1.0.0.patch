--- gcc-2.95.2/gcc/testsuite/gcc.c-torture/code_quality/920608-1.c	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/code_quality/920608-1.c	Wed May 19 22:14:48 1999
@@ -0,0 +1,25 @@
+foo (p)
+     int *p;
+{
+  int x;
+  int a;
+
+  a = p[0];
+  x = a + 5;
+  a = -1;
+  p[0] = x - 5;
+  return a;
+}
+
+bar (p)
+{
+  short x;
+  int a;
+
+  x = ((short *) p)[1];
+#if INHIBIT_COMBINE
+  ((short *) p)[0] = x;
+#endif
+
+  return (x < 45);
+}
