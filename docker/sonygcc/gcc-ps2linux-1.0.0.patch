diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.other/conv6.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.other/conv6.C
--- gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.other/conv6.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.other/conv6.C	Mon May 24 18:22:19 1999
@@ -0,0 +1,28 @@
+// Test for composite pointer types, as defined in [expr.rel],
+// and common pointer to member types, as defined in [expr.eq].
+
+struct A { int i; };
+struct B : public A { };
+
+int main ()
+{
+  B b;
+
+  // The composite type is `A const *'
+        A* ap = &b;
+  const B* bp = &b;
+  if (ap != bp)		// gets bogus error - distinct types XFAIL *-*-*
+    return 1;
+
+  // The composite type is `B const *const *'
+  B       *const * p = 0;
+  B const *      * q = 0;
+  if (p != q)		// gets bogus error - distinct types XFAIL *-*-*
+    return 1;
+
+  // The common type is `int const B::*'
+  const int A::*apm = &A::i;
+        int B::*bpm = &A::i;
+  if (apm != bpm)	// gets bogus error - distinct types XFAIL *-*-*
+    return 1;
+}
