diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/gcc.c-torture/execute/strct-stdarg-1.c gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/execute/strct-stdarg-1.c
