+    abort();
+  exit(0);
+}
+maxbol(double vp , double *vx , double *vy , double *vz)
+{
+  int idum=0;
+  int i;
+  double temp;
+
+  *vx=vp*ran( &idum );
+  *vy=vp*ran( &idum );
+  *vz=vp*ran( &idum );
+}
+
+double ran(int *idum)
+{
+  static long ix1,ix2,ix3;
+  static double r[97];
+  double temp;
+  static int iff=0;
+  int j;
+
+ if(*idum<0 || iff==0){
+   iff=1;
+   ix1=(54773-(*idum))%259200;
+   ix1=(7141*ix1+54773)%259200;
+   ix2=ix1 %134456;
+   ix1=(7141*ix1+54773)%259200;
+   ix3=ix1 %243000;
+   for(j=0; j<97; j++){
+     ix1=(7141*ix1+54773)%259200;
+     ix2=(8121*ix2+28411)%134456;
+     r[j]=(ix1+ix2*(1.0/134456))*(1.0/259200);
+   }
+   *idum=1;
+ }
+  ix1=(7141*ix1+54773)%259200;
+  ix2=(8121*ix2+28411)%134456;
+  ix3=(4561*ix3+51349)%243000;
+  j=((97*ix3)/243000);
