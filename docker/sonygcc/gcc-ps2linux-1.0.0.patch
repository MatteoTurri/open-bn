+++ gcc-2.95.2.current/gcc/testsuite/g77.f-torture/execute/19990419-1.f	Mon May 24 18:22:20 1999
@@ -0,0 +1,21 @@
+* Test DO WHILE, to make sure it fully reevaluates its expression.
+* Belongs in execute/.
+      common /x/ ival
+      j = 0
+      do while (i() .eq. 1)
+         j = j + 1
+         if (j .gt. 5) call abort
+      end do
+      if (j .ne. 4) call abort
+      if (ival .ne. 5) call abort
+      end
+      function i()
+      common /x/ ival
+      ival = ival + 1
+      i = 10
+      if (ival .lt. 5) i = 1
+      end
+      block data
+      common /x/ ival
+      data ival/0/
+      end
