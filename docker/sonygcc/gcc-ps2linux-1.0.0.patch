+  uu.ti = u;
+
+  bm = (sizeof (DItype) * BITS_PER_UNIT) - b;
+  if (bm <= 0)
+    {
+      /* w.d.high = 1..1 or 0..0 */
+      w.d.high = uu.d.high >> (sizeof (DItype) * BITS_PER_UNIT - 1);
+      w.d.low = uu.d.high >> -bm;
+    }
+  else
+    {
+      UDItype carries = (UDItype)uu.d.high << bm;
+      w.d.high = uu.d.high >> b;
+      w.d.low = ((UDItype)uu.d.low >> b) | carries;
