+++ gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/unsorted/PYRBUG.c	Wed May 19 22:14:49 1999
@@ -0,0 +1,17 @@
+typedef struct
+{
+  int v;
+  int h;
+} Point;
+
+typedef struct
+{
+  int top, left, bottom, right;
+} Rect;
+
+int
+x_PtInRect (Point pt, Rect *r)
+{
+  return  pt.v >= r->top  && pt.v < r->bottom
+    && pt.h >= r->left && pt.h < r->right;
+}
