+    T r;
+    r.i = this->i + o.i;
+    return r;
+  }
+  operator int () {
+    return i;
+  }
+  ~T() {
+    --count;
+  }
+} s, b;
+
+void bar() {
+  static int j = int(s+b);
+  int i = int(s+b);
+}
+
+int i = int(s+b);
+
+int main() {
+  bar();
+  bar();
+  return count != 2;
+}
