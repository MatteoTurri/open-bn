+++ gcc-2.95.2.current/gcc/testsuite/g++.dg/special/conpr-1.C	Mon May 24 18:22:17 1999
@@ -0,0 +1,18 @@
+/* { dg-do run } */
+
+class foo_t {
+    int x;
+public:
+    foo_t(void) { x=1; }
+    int get(void) { return x; }
+};
+
+static foo_t foo __attribute__((init_priority(5000)));
+
+int main(void) {
+
+    if (foo.get())
+        exit(0);
+    else
+        abort();
+}
diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.dg/special/conpr-2.C gcc-2.95.2.current/gcc/testsuite/g++.dg/special/conpr-2.C
--- gcc-2.95.2/gcc/testsuite/g++.dg/special/conpr-2.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.dg/special/conpr-2.C	Mon May 24 18:22:17 1999
@@ -0,0 +1,20 @@
+/* { dg-do run } */
+
+class foo_t {
+    int x;
+    static int count;
+public:
+    foo_t(void) { x=++count; }
+    int get(void) { return x; }
+};
+
+int foo_t::count;
+
+extern foo_t foo1, foo2;
+
+int main(void) {
+
+    if ( (foo1.get() != 2) || (foo2.get() != 1) )
+        abort();
+    exit(0);
+}
