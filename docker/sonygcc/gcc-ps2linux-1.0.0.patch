diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/gcc.c-torture/execute/va-arg-4.c gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/execute/va-arg-4.c
--- gcc-2.95.2/gcc/testsuite/gcc.c-torture/execute/va-arg-4.c	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/execute/va-arg-4.c	Wed May 19 22:14:49 1999
@@ -0,0 +1,33 @@
+/* On the i960 any arg bigger than 16 bytes causes all subsequent args
+   to be passed on the stack.  We test this.  */
+
+#include <stdarg.h>
+
+typedef struct {
+  char a[32];
+} big;
+
+void
+f (big x, char *s, ...)
+{
+  va_list ap;
+
+  if (x.a[0] != 'a' || x.a[1] != 'b' || x.a[2] != 'c')
+    abort ();
+  va_start (ap, s);
+  if (va_arg (ap, int) != 42)
+    abort ();
+  if (va_arg (ap, int) != 'x')
+    abort ();
+  if (va_arg (ap, int) != 0)
+    abort ();
+  va_end (ap);
+}
+
+main ()
+{
+  static big x = { "abc" };
+
+  f (x, "", 42, 'x', 0);
+  exit (0);
+}
diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/gcc.c-torture/execute/va-arg-5.c gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/execute/va-arg-5.c
--- gcc-2.95.2/gcc/testsuite/gcc.c-torture/execute/va-arg-5.c	Thu Jan  1 09:00:00 1970
