diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/gcc.c-torture/unsorted/logic.c gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/unsorted/logic.c
--- gcc-2.95.2/gcc/testsuite/gcc.c-torture/unsorted/logic.c	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/unsorted/logic.c	Wed May 19 22:14:49 1999
@@ -0,0 +1,37 @@
+logic (a, b)
+     int *a, b;
+{
+  if (*a & 123)
+    b = 1;
+  if (*a & ~222)
+    b = 2;
+  if (124 & *a)
+    b = 3;
+  if (~111 & *a)
+    b = 4;
+
+  if (~*a & 23)
+    b = 1;
+  if (~*a & ~22)
+    b = 2;
+  if (24 & ~*a)
+    b = 3;
+  if (~11 & ~*a)
+    b = 4;
+
+  if (~*a & b)
+    b = 1;
+  if (~*a & ~b)
+    b = 2;
+  if (*a & ~*a)
+    b = 3;
+  return b;
+}
+
+x (a, b, c)
+{
+  for (a = 0;  --a > 0;);
+  for (b = -1; --b > 0;);
+  for (c = -65536; --c > 0;);
+  return a + b + c;
+}
