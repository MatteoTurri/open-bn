+}
+#endif
+
+#ifdef L_ffsti2
+TItype
+__ffsti2 (TItype u)
+{
+  TIunion uu, w;
+  uu.ti = u;
+  w.d.high = 0;
+  w.d.low = __ffsdi2 (uu.d.low);
+  if (w.d.low != 0)
+    return w.ti;
+  w.d.low = __ffsdi2 (uu.d.high);
+  if (w.d.low != 0)
+    {
+      w.d.low += BITS_PER_UNIT * sizeof (DItype);
+      return w.ti;
+    }
