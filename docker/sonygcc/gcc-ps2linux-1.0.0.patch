+template <int N>
+struct Outer{
+  struct Inner{
+    Inner(int n): sum(n){}
+
+    typename Outer<N-1>::Inner operator[](int n) const
+    { return typename Outer<N-1>::Inner(sum + n); }
+
+    int sum;
+  };
