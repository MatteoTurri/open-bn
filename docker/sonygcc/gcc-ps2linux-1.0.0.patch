diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.ns/alias6.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.ns/alias6.C
--- gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.ns/alias6.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.ns/alias6.C	Mon May 24 18:22:19 1999
@@ -0,0 +1,35 @@
+// Check namespace aliases inside blocks
+namespace A { 
+  int i;
+  void f(){
+    i = 0;
+  }
+}
+
+int g();
+
+int main ()
+{
+  namespace B = A;
+  B::i=42;
+  B::f();
+  using namespace B;
+  f();
+  // A::i is now 0, B::i is 1
+  return g();
+}
+
+namespace B {
+  int i = 1;
+}
+
+int g()
+{
+  namespace x = A;
+  if (x::i)
+  {
+    namespace x = B;
+    return x::i;
+  }
+  return x::i;
+}
