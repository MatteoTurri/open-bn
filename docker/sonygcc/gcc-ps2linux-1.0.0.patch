-/* Record EXPR in the current function block. Complements compound
-   expression second operand if necessary.  */
-
-tree
-java_method_add_stmt (fndecl, expr)
-     tree fndecl, expr;
-{
-  return add_stmt_to_block (GET_CURRENT_BLOCK (fndecl), NULL_TREE, expr);
