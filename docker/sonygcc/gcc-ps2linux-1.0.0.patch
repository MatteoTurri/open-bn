+div_and_round_double (lden_orig, hden_orig)
+     int lden_orig, hden_orig;
+{
+  int quo[4];
+  register int i;
+  unsigned int  work;
+  register unsigned int  carry = 0;
+  int  lden = lden_orig;
+  int  hden = hden_orig;
