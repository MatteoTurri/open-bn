diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.ns/template5.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.ns/template5.C
--- gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.ns/template5.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.ns/template5.C	Mon May 24 18:22:19 1999
@@ -0,0 +1,33 @@
+//Check whether namespace-scoped template instantiations
+//are mangled differently.
+
+namespace X{
+  template<class T>
+  struct Y{
+   int f(T){
+     return 1;
+   }
+   template<class X>void g(){}
+  };
+}
+
+template<class T>
+struct Y{
+  int f(T){
+    return 2;
+  }
+};
+
+int main()
+{
+  X::Y<int> z;
+  if (z.f(4) != 1)
+    return 1;
+  z.template g<long>();
+
+  Y<int> z1;
+  if (z1.f(5) != 2)
+    return 1;
+  return 0;
+}
+
