+    if ((status = execute(((void *)0), "rm", rmstring, 1)) != 0) {
+      XBell(XtDisplay(w), 100);
+      query_dialog("Can't remove file", 0);
+    }
+    XtFree(rmstring);
+
+    directoryManagerNewDirectory(cwd);
+  } else {
+    changestate(1);
+  }
+  setCursor(left_ptr);
+  freeReturnStruct();
