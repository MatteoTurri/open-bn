--- gcc-2.95.2/gcc/testsuite/gcc.misc-tests/gcov.exp	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/gcc.misc-tests/gcov.exp	Wed May 19 22:14:50 1999
@@ -0,0 +1,95 @@
+#   Copyright (C) 1997 Free Software Foundation, Inc.
+
+# This program is free software; you can redistribute it and/or modify
