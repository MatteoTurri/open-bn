+//980323 bkoz
+//test for bools with inclusive ors
+
+#include <assert.h>
+void bar ( bool  x ) {};
+void bars ( short  x ) {};
+
+/* 980326 bkoz this is not initialized and so can have indeterminate value. */
+#if 0
+int orb(){
+  bool y;
+  bar ( y );
+  int blob = ( 27 | int (y) );
+  return blob; //expect 27 or 0
+}
+#endif
+
+int orbtrue(){
+  bool y = true;
+  bar ( y );
+  int blob = ( 27 | int (y) );
+  return blob; //expect 27
+}
+
+int orbfalse(){
+  bool y = false;
+  bar ( y );
+  int blob = ( 27 | int (y) );
+  return blob; //expect 27
+}
+
+int orbfalse2(){
+  bool y = 0;
+  bar ( y );
+  int blob = ( 27 | int (y) );
+  return blob;  //expect 27
+}
+
+int ors(){
+  short y = 1;
+  bars ( y );
+  int blob = ( 27 | int (y) );
+  return blob;  //expect 27
+}
+
+
+int orus(){
+  unsigned short y = 1;
+  bars ( y );
+  int blob = ( 65539 | int (y) );
+  return blob;  //expect 65539, will be 3 if done in us type
+}
