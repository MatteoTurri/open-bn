+	{CCR_CTR1_LOW_BRANCH_ISSUED   ,   "Low-order_branch_issued"},
+	{CCR_CTR1_CPU_CYCLE           ,   "Processor_cycle"},
+	{CCR_CTR1_DUAL_ISSUE          ,   "Dual_instructions_issue"},
+	{CCR_CTR1_BRANCH_MISS_PREDICT ,   "Branch_miss-predicted"},
+	{CCR_CTR1_ITLB_MISS           ,   "ITLB_miss"},
