+  uu.ti = u,
+  vv.ti= v;
+
+  w.ti = __umulditi3 (uu.d.low, vv.d.low);
+  w.d.high += ((UDItype) uu.d.low * (UDItype) vv.d.high
+	       + (UDItype) uu.d.high * (UDItype) vv.d.low);
