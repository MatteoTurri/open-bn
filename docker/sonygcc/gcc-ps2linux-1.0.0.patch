+
+  p = (fptr)(ap->*fp);
+  p = (fptr)(ap->*fp);
+  p = (fptr)(ap->*(&A::f));
+  p = (fptr)(a.*fp);
+  p = (fptr)(a.*(&A::f));
+
+  q = (vptr)(ap->*fp);
+  q = (vptr)(ap->*(&A::f));
+  q = (vptr)(a.*fp);
+  q = (vptr)(a.*(&A::f));
+}
