diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.jason/temporary3.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.jason/temporary3.C
--- gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.jason/temporary3.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.jason/temporary3.C	Mon May 24 18:22:18 1999
@@ -0,0 +1,26 @@
+// Bug: the temporary returned from f is elided, causing a to be constructed
+// twice but only destroyed once.
+
+extern "C" int printf (const char *, ...);
+
+int c,d;
+
+struct A {
+  A (int) { c++; }
+  ~A () { d++; }
+  A (const A&) { c++; }
+  int i;
+};
+
+A f ()
+{ return 1; }
+
+int main ()
+{
+  {
+    A a (1);
+    a = f ();
+  }
+  printf ("%d %d\n", c, d);
+  return c != d;
+}
