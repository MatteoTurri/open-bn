+public:
+    int bar() const
+    { return 0; }
+};
+
+template<class X>
+struct base_trait {
+    typedef base1 base;
+};
+
+struct base_trait<float> {
+    typedef base2 base;
+};
+
+template<class T>
+class weird : public base_trait<T>::base {
+public:
+    typedef base_trait<T>::base base;
+
+    base f ();
+    int base::* g ();
+
+    int zowee() const
+    { return bar(); }  
+};
+
+template <class T>
+weird<T>::base weird<T>::f ()
+{
+    return base();
+}
+
+template <class T>
+int weird<T>::base::* weird<T>::g ()
+{ return 0; }
+
+int main()
+{
+    weird<float> z;
+    return z.zowee() || z.f().bar();
+}
