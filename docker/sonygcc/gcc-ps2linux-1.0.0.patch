+void LS::init_vect_d(double param[]) const
+{
+  param[0]=t_x;
+  param[1]=t_y;
+  param[2]=k;
+  param[3]=theta;
+}
+
+void LS::init_from_vect_f(const float param[])
+{
+  t_x=param[0];
+  t_y=param[1];
+  k=param[2];
+  theta=param[3];
+}
+
+void LS::init_vect_f(float param[]) const
+{
+  param[0]=t_x;
+  param[1]=t_y;
+  param[2]=k;
+  param[3]=theta;
+}
