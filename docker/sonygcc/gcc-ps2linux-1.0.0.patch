+/**
+ **
+ ** Basic Block Counting Support
+ **
+ **/
+
+
+
+/* save/restore */
+ 
+static const short bb_profiler_save_targets[]={
+	28	/*gp*/
+	,31	/*ra*/
+	,25	/*t9*/
+	,4	/*a0*/ 
+	,5	/*a1*/ 
+	,6	/*a2*/ 
+	,7	/*a3*/ 
+	,1	/*at*/
+	,2	/*v0*/ 
+	,3	/*v1*/
+	,30	/*fp*/
+	,8	/*t0*/
+	,9	/*t1*/
+	,10	/*t2*/
+	,11	/*t3*/
+	,12	/*t4*/
+	,13	/*t5*/
+	,14	/*t6*/
+	,15	/*t7*/
+	,24	/*t8*/
+	};
+
+static const int num_of_bb_profiler_save_targets
+		= sizeof(bb_profiler_save_targets)/
+			sizeof(short);
+
+static 
+void
+bb_profiler_save_restore_one(int on_save,  FILE *file, int regno,  int index)
+{
+	if (file) {
+		int reg_size= GET_MODE_SIZE(gpr_mode);
+		char *store_inst="sw";
+		char *load_inst ="lw";
+
+		if (reg_size == GET_MODE_SIZE(DImode)) {
+			store_inst="sd";
+			load_inst ="ld";
+		}
+		if (on_save) {
+			fprintf(file, "\t%s \t $%d, %d($29)\n",
+					store_inst, regno,(index+4)*reg_size );
+		}
+		else {
+			fprintf(file, "\t%s \t $%d, %d($29)\n",
+					load_inst, regno,(index+4)*reg_size );
+		}
+	}
+	else {
+		rtx reg_rtx;
+		rtx mem_rtx;
+  
+		mem_rtx = gen_rtx (MEM, gpr_mode,
+			gen_rtx (PLUS, Pmode, stack_pointer_rtx,
+				GEN_INT ((index+4) *  GET_MODE_SIZE (gpr_mode))));
+  
+		reg_rtx = gen_rtx (REG, gpr_mode, regno);
+  
+		if (on_save)
+			emit_move_insn (mem_rtx, reg_rtx);
+		else
+			emit_move_insn (reg_rtx, mem_rtx);
+    
+	}
+}
