+
+#define LABEL_LEN 256
+#ifndef MIPS_BB_PROFILER_SAVE_REGS_HELPER
+#define MIPS_BB_PROFILER_SAVE_REGS_HELPER \
+		"__bb_mips_save_regs_"
+#endif
+
+#ifndef MIPS_BB_PROFILER_RESTORE_REGS_HELPER
+#define MIPS_BB_PROFILER_RESTORE_REGS_HELPER \
+		"__bb_mips_restore_regs_"
+#endif
+
+static void bb_profiler_save_restore_regs(int on_save, FILE *file)
+{
+	int stack_size;
+	rtx operands[2];
+	char *save_helper_prefix = 
+		MIPS_BB_PROFILER_SAVE_REGS_HELPER;
+	char *restore_helper_prefix = 
+		MIPS_BB_PROFILER_RESTORE_REGS_HELPER;
+	static char save_label[LABEL_LEN] = {'\0'};
+	static char restore_label[LABEL_LEN] = {'\0'};
+	char *subu_inst = (Pmode == DImode) ?  "dsubu" : "subu";
+	char *addu_inst = (Pmode == DImode) ?  "daddu" : "addu";
+	char *store_inst="sw";
+	char *load_inst ="lw";
+	int reg_size = GET_MODE_SIZE (gpr_mode);
+
+	if (reg_size == GET_MODE_SIZE(DImode)) {
+		store_inst="sd";
+		load_inst ="ld";
+	}
+
+  
+	stack_size = num_of_bb_profiler_save_targets;
+	stack_size += 2;	/* area for lo and hi */
+	stack_size += 4;	/* reserved for args */
+#ifdef MIPS_BB_PROFILER_NUMBER_OF_MD_REGS
+	/* area for machine depedant registers */
+	stack_size += MIPS_BB_PROFILER_NUMBER_OF_MD_REGS;
+#endif
+	stack_size = MIPS_STACK_ALIGN(stack_size*reg_size);
+
+	switch(on_save) {
+	  case 0:
+		if (!restore_label[0]) {
+			int load_inst_len = strlen(load_inst)+1;
+			restore_label[LABEL_LEN-1-load_inst_len] = '\0';
+			strncpy(restore_label,
+				restore_helper_prefix,
+				LABEL_LEN-load_inst_len);
+			strcat(restore_label,load_inst);
+		}
+	  	break;
+	  case 1:
+		if (!save_label[0]) {
+			int store_inst_len = strlen(store_inst)+1;
+			save_label[LABEL_LEN-1-store_inst_len] = '\0';
+			strncpy(save_label,
+				save_helper_prefix,
+				LABEL_LEN-store_inst_len);
+			strcat(save_label,store_inst);
+		}
+	  	break;
+	}
+
+
+	switch(on_save) {
+	  case 0:
+		/* restore GP first */
+		bb_profiler_save_restore_one(0, file,  28/*gp*/,  0);
+
+		/* save remains, except RA and T9 */
+		if (file) {
+			fprintf(file, "\tla \t $25, %s\n", restore_label );
+			fprintf(file, "\tjalr $25\n");
+		}
+		else {
+			operands[0] = gen_rtx (SYMBOL_REF, Pmode, restore_label);
+			operands[1] = const0_rtx;
+			emit_call_insn (gen_call_indirect_internal (operands[0], 
+				operands[1],
+				gen_rtx (REG, SImode, GP_REG_FIRST + 31)));
+		}
+
+		/* finaly, restore RA and T9 */
+		bb_profiler_save_restore_one(0, file, 31/*ra*/,  1);
+		bb_profiler_save_restore_one(0, file, 25/*t9*/,  2);
+
+		/* shrink stack */
+		if (file) {
+			fprintf(file, "\t %s \t $29, %d\n", addu_inst,
+				stack_size);
+		}
+		else {
+			if (Pmode == DImode )
+				emit_insn (gen_adddi3 (stack_pointer_rtx, 
+					stack_pointer_rtx,
+					GEN_INT(stack_size)));
+			else
+				emit_insn (gen_addsi3 (stack_pointer_rtx, 
+					stack_pointer_rtx,
+					GEN_INT(stack_size)));
+		}
+	  	break;
+
+	  case 1:
+		/* grow stack  */
+		if (file) {
+			fprintf(file, "\t %s \t $29, %d\n",subu_inst,
+				stack_size);
+		}
+		else {
+		    if (Pmode == DImode)
+			emit_insn (gen_subdi3 (stack_pointer_rtx, 
+				stack_pointer_rtx,
+  				GEN_INT(stack_size)));
+		    else
+			emit_insn (gen_subsi3 (stack_pointer_rtx, 
+				stack_pointer_rtx,
+  				GEN_INT(stack_size)));
+		}
+
+		/* save GP, RA and T9 */
+		bb_profiler_save_restore_one(1, file, 28/*gp*/,  0);
+		bb_profiler_save_restore_one(1, file, 31/*ra*/,  1);
+		bb_profiler_save_restore_one(1, file, 25/*t9*/,  2);
+
+		/* save remains */
+		if (file) {
+			fprintf(file, "\tla \t $25, %s\n", save_label );
+			fprintf(file, "\tjalr $25\n");
+		}
+		else {
+			operands[0] = gen_rtx (SYMBOL_REF, Pmode, save_label);
+			operands[1] = const0_rtx;
+			emit_call_insn (gen_call_indirect_internal (operands[0], 
+				operands[1],
+				gen_rtx (REG, SImode, GP_REG_FIRST + 31))); 
+		}
+		break;
+	}
+
+}
+
+static void bb_profiler_save_restore_selected_regs
+	(int on_save, FILE *file, int num_of_regs, ...)
+{
+	va_list ap;
+	int i;
+	int reg_size= GET_MODE_SIZE(gpr_mode);
+	char *store_inst="sw";
+	char *load_inst ="lw";
+	char * subu_inst = (Pmode == DImode) ?  "dsubu" : "subu";
+	char * addu_inst = (Pmode == DImode) ?  "daddu" : "addu";
+	int stack_size;
+
+	if (reg_size == GET_MODE_SIZE(DImode)) {
+		load_inst="ld";
+		store_inst="sd";
+	}
+
+	stack_size=MIPS_STACK_ALIGN(num_of_regs*reg_size);
+
+	va_start(ap, num_of_regs);
+	switch (on_save) {
+	case 0:
+		for (i = 0 ; i < num_of_regs; i++) {
+			char *regname = va_arg(ap, char *);
+			fprintf(file, "\t%s \t %s, %d($29)\n",
+				load_inst, regname,i*reg_size );
+		}
+
+		fprintf(file, "\t %s \t $29, %d\n", addu_inst,
+			stack_size);
+		fprintf(file, "\t.set pop\n");
+		break;
+
+	case 1:
+		fprintf(file, "\t.set push\n");
+		fprintf(file, "\t.set noat\n");
+		fprintf(file, "\t %s \t $29, %d\n", subu_inst,
+			stack_size);
+
+		for (i = 0 ; i < num_of_regs; i++) {
+			char *regname = va_arg(ap, char *);
+			fprintf(file, "\t%s \t %s, %d($29)\n",
+				store_inst, regname,i*reg_size );
+		}
+		break;
+	}
+	va_end(ap);
+}
