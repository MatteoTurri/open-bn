-{
-  if (TREE_CODE (decl) == FIELD_DECL && decl != current_this
-      && !FIELD_STATIC (decl))
-    decl = build_field_ref (where ? where : current_this, 
-			    (type ? type : DECL_CONTEXT (decl)),
-			    DECL_NAME (decl));
-  return decl;
-}
