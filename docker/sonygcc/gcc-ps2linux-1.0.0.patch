+inline
+static
+int bb_performance_counter_parser(const char *p, int perfcounter)
+{
+	int i;
+
+	i =     strlen("target:");
+	if (!strncmp(p,"target:", i) ){
+		p += i;
+		i = 0;
+		--p;
+		do {
+			p ++;
+			switch (*p) {
+			  case 'U':
+				i |=  CCR_TARGET_U;
+				break;
+			  case 'S':
+				i |=  CCR_TARGET_S;
+				break;
+			  case 'K':
+				i |=  CCR_TARGET_K;
+				break;
+			  case 'E':
+				i |=  CCR_TARGET_EXL;
+				break;
+			  default:
+				return 0;
+			}
+			p ++;
+		}
+		while ( *p == '|' );
+		target[perfcounter] = i;
+		return 1;
+	}
+	else{
+		i =     strlen("event:");
+		if (!strncmp(p,"event:", i) ){
+			struct event_table *acceptable_event = 
+				event_selector[perfcounter];
+			p += i;
+			i = 0;
+			while ( acceptable_event[i].name ) {
+				if ( !strcmp(acceptable_event[i].name, p)) {
+					event[perfcounter] = 
+						acceptable_event[i].val;
+					return 1;
+				}
+				i ++;
+			}
+			return 0;
+		}
+	}
+}
+
+inline 
+static void bb_shutdown_ctrs(void)
+{
+	int ccr;
+	ccr=0;
+	sysmips(MIPS_SYS_R5900,SYS_R5900_SET_CCR, &ccr);
+}
+
+/*
+ * return 1 if busy or fail.
+ * oterwise return 0;
+ */
+inline 
+static int bb_init_ctrs(void)
+{
+	int ccr;
+	struct sys_r5900_ctrs zero_ctrs = {0,0};
+	if (sysmips(MIPS_SYS_R5900,SYS_R5900_GET_CCR, &ccr)){
+		return 1;
+	}
+	if (CCR_GET_CTE(ccr))
+		return 1;
+	ccr = 0;
+	if ( sysmips(MIPS_SYS_R5900,SYS_R5900_SET_CCR, &ccr))
+		return 1;;
+	if (sysmips(MIPS_SYS_R5900,SYS_R5900_SET_CTRS, &zero_ctrs))
+		return 1;;
+
+	ccr = CCR_SET_CTE(ccr, 1);
+	ccr = CCR_SET_CTR0_TARGET(ccr, target[0]);
+	ccr = CCR_SET_CTR1_TARGET(ccr, target[1]);
+	ccr = CCR_SET_CTR0_EVENT(ccr, event[0]);
+	ccr = CCR_SET_CTR1_EVENT(ccr, event[1]);
+
+	return (sysmips(MIPS_SYS_R5900,SYS_R5900_SET_CCR, &ccr));
+}
+
+inline
+static int bb_get_ctrs( struct sys_r5900_ctrs *p_val)  
+{
+	return sysmips(MIPS_SYS_R5900,SYS_R5900_GET_CTRS, p_val);
+}
+
+inline 
+static void bb_delta_ctrs( 
+	struct sys_r5900_ctrs *p_dst,  
+	struct sys_r5900_ctrs *p_new,  
+	struct sys_r5900_ctrs *p_old)  
+{
+	p_dst->ctr0 = p_new->ctr0 - p_old->ctr0;
+	p_dst->ctr1 = p_new->ctr1 - p_old->ctr1;
+	p_dst->ctr0 &=  ~( (__u64) 1 << 63 );
+	p_dst->ctr1 &=  ~( (__u64) 1 << 63 );
+}
+
+
+/* bb_record_perf_count() */
+/* 	update previous_bb's perfctrs record */
+/* 	update previous_bb as given *p__bb */
+/*	record current value of perfctrs into "bbperfcount.gz" */
+/*		if trace_flag is ON */
+
+#define BB_TRACE_ON	1
+#define BB_TRACE_OFF	0
+inline
+static
+void bb_record_perf_count(const struct __bb * p__bb, int trace_flag)
+{
+	struct sys_r5900_ctrs delta_ctrs, ctrs;
+
+	/* obatin current counters */
+	bb_get_ctrs(&ctrs);
+
+	/* calc. ctrs diff */
+	bb_delta_ctrs(&delta_ctrs, &ctrs, &bb_last_ctrs);
+
+	/* update last ctrs */
+	bb_last_ctrs = ctrs;
+ 
+	if (previous_bb.blocks) {
+		register struct sys_r5900_ctrs * p_ctrs;
+		p_ctrs = previous_bb.blocks->
+				extension[previous_bb.blockno].private;
+		p_ctrs ->ctr0 += delta_ctrs.ctr0;
+		p_ctrs ->ctr1 += delta_ctrs.ctr1;
+	}
+	previous_bb = *p__bb;
+	if (!bb_perfcountfile) return;
+
+	if ( trace_flag == BB_TRACE_ON) {
+		/* write current ctrs */
+		fwrite (&ctrs, sizeof (ctrs), 1, bb_perfcountfile);
+	}
+}
+
+/*
+ * exported methods
+ *
+ *
+ */
+
+/*
+ * constructor/destructor of private record
+ */
+int __bb_alloc_r5900_perf_counter(void **p_private)
+{
+	*p_private = calloc(1, sizeof(struct sys_r5900_ctrs));
+	return ( *p_private != 0);
+};
+
+void __bb_free_r5900_perf_counter(void **p_private)
+{
+	if (*p_private) { 
+		free(*p_private); 
+		*p_private = 0;
+	}
+};
+
+
+/*
+ * reporter of private record
+ */
+void __bb_print_r5900_perf_counter(FILE *file, void *private)
+{
+	struct sys_r5900_ctrs *p_ctrs  = private;
+	if (bb_enable_perfcounter) {
+		fprintf(file," counter#0(0x%01x:0x%02x):0x%016llx", 
+			target[0],event[0], p_ctrs->ctr0);
+		fprintf(file," counter#1(0x%01x:0x%02x):0x%016llx", 
+			target[1],event[1], p_ctrs->ctr1);
+	}
+}
+
+/*
+ * parser of bb.in 
+ */
+int __bb_parse_r5900_perf_counter(const char *p)
+{
+	int i;
+	if (!strcmp(p,"enable_trace_performance_counter") ){
+		bb_enable_trace_perfcounter = 1;
+		return 1;
+	};
+	if (!strcmp(p,"enable_performance_counter") ){
+		bb_enable_perfcounter = 1;
+		return 1;
+	};
+
+	i =     strlen("performance_counter#");
+	if (!strncmp(p,"performance_counter#", i) ){
+		int perfcounter;
+		p += i;
+		perfcounter = *p -'0';
+		if (perfcounter != 0 && perfcounter != 1 ) {
+			return 0;
+		}
+		p ++;
+		if (*p != ':' ) return 0;
+		p ++;
+		
+		return bb_performance_counter_parser(p, perfcounter);
+
+	}
+	return 0;
+}
+
+/*
+ * called once per program.
+ */
+
+void __bb_init_r5900_perf_counter()
+{
+	if (bb_enable_perfcounter) {
+		perf_bb_stacksize = BB_INITAL_STACK_SIZE;
+		perf_bb_stack = (struct __bb *) malloc 
+				(perf_bb_stacksize * sizeof (struct __bb));
+		if (!perf_bb_stack)
+			perf_bb_stacksize = 0;
+
+		if (bb_init_ctrs()) {
+			/* fail or busy */
+			bb_enable_perfcounter=0;
+			bb_enable_trace_perfcounter=0;
+			return ;
+		};
+		bb_get_ctrs(&bb_last_ctrs);
+	}
+	if (bb_enable_trace_perfcounter) {
+		bb_enable_perfcounter = 1;
+#ifdef HAVE_POPEN 
+		bb_perfcountfile = gopen ("bbperfcount.gz", "w");
+#else
+		bb_perfcountfile = fopen ("bbperfcount", "w");
+#endif
+	}
+}
+
+void __bb_exit_r5900_perf_counter()
+{
+	if ( bb_enable_perfcounter ) {
+		/* record final. portion */
+		bb_record_perf_count(&dummy_bb,BB_TRACE_ON);
+		/* shutdown counter */
+		bb_shutdown_ctrs();
+	}
+	if (bb_perfcountfile) {
+#ifdef HAVE_POPEN
+		gclose (bb_perfcountfile);
+#else
+		fclose (bb_perfcountfile);
+#endif /* HAVE_POPEN */
+	}
+	if (perf_bb_stack) {
+		free (perf_bb_stack);
+		perf_bb_stack = 0;
+	}
+}
+
+
+/*
+ * called on every entering to BB.
+ */
+void __bb_trace_r5900_perf_counter(struct __bb *p__bb)
+{
+	if ( bb_enable_perfcounter ) {
+		bb_record_perf_count(p__bb, BB_TRACE_ON);
+	}
+}
+
+
+/*
+ * called on every entering to function.
+ */
+void __bb_init_trace_r5900_perf_counter
+	(struct bb *blocks, unsigned long blockno)
+{
+	static short reported = 0;
+
+	/* return if perfcounting is not enabled */
+	if ( !bb_enable_perfcounter ) {
+		return;
+	}
+
+	/* update last ovserved counter value and then return, 
+		if cannot operate previous_bb's stack.*/
+	if (perf_bb_stacksize == 0) {
+		bb_record_perf_count(&dummy_bb,BB_TRACE_OFF);
+		return;
+	}
+
+
+	if (perf_bb_callcount) {
+
+		perf_bb_callcount ++;
+
+		/* grow stack, if needed */
+		if (perf_bb_callcount >= perf_bb_stacksize) {
+			int newsize = perf_bb_callcount + 
+					BB_GROWTH_OF_STACK_SIZE;
+			perf_bb_stack = (struct __bb *) 
+				realloc (perf_bb_stack, 
+				newsize*sizeof(struct __bb));
+			if (! perf_bb_stack) {
+				if (!reported) {
+					fprintf (stderr, 
+					   "Profiler: out of memory\n");
+					reported = 1;
+				}
+				perf_bb_stacksize = 0;
+				goto stack_overflow;
+			}
+			perf_bb_stacksize = newsize;
+		}
+
+		/* push previous_bb */
+		perf_bb_stack[perf_bb_callcount] = previous_bb;
+		/* recored perfcounters in previous_bb,
+			counted before entering the function */
+		bb_record_perf_count(&dummy_bb,BB_TRACE_OFF);
+stack_overflow:
+		return;
+	}
+
+	if (blocks->extension && 
+	      (blocks->extension[blockno].flags & TRACE_ON)) {
+
+		perf_bb_callcount = 1;
+		previous_bb=dummy_bb;
+		if (perf_bb_stack)
+			perf_bb_stack[perf_bb_callcount] = previous_bb;
+
+		/* update last ovserved counter value */
+		bb_record_perf_count(&dummy_bb,BB_TRACE_OFF);
+	} 
+}
+
+/*
+ * called on every leaving from function.
+ */
+
+void __bb_ret_trace_r5900_perf_counter(void)
+{
+	if ( !bb_enable_perfcounter ) {
+		return;
+	}
+
+	if (perf_bb_callcount) {
+		if ( perf_bb_stacksize > perf_bb_callcount) {
+		/* record counters in the last part of the function 
+			and pop previous_bb, if possible */
+			bb_record_perf_count (
+				&(perf_bb_stack[perf_bb_callcount]),
+				BB_TRACE_OFF);
+		}
+		else {
+	 		/* update last observed counters,  */
+			/* if stack is overflowed. */
+			bb_record_perf_count(&dummy_bb,BB_TRACE_OFF);
+		}
+		perf_bb_callcount --;
+	}
+}
+
+void __r5900_update_ctrs(void)
+{
+	bb_get_ctrs(&bb_last_ctrs);
+}
+
