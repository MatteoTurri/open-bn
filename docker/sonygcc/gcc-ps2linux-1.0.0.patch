+// Test for PRETTY_FUNCTION
+// Build don't link:
+
+class SV;
+
+class SVTable // : public Debug
+{
+  // It is an array to pointer to a SV.
+  SV ** array;
+
+  // This is the size of array.
+  int maxCount; 
+
+  // This is the current element count.
+  int count;
+
+  void fatal_error (const char *f, ...);
