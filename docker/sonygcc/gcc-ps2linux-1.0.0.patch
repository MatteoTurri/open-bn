+TItype
+__negti2 (TItype u)
+{
+  TIunion w;
+  TIunion uu;
+
+  uu.ti = u;
+
+  w.d.low = -uu.d.low;
+  w.d.high = -uu.d.high - ((UDItype) w.d.low > 0);
+
+  return w.ti;
+}
