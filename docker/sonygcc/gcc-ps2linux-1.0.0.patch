+    if (ptr1 != (RWSlistIterator*)this)
+      fail = 5;
+    if (ptr2 != &(*this).slist)
+      fail = 6;
+
+    if (0) printf("at %x %x\n", (RWSlistIterator*)this, &(*this).slist);
+  }
+};
