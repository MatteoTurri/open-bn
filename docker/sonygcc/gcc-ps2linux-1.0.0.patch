-  if (!IS_CLINIT (method) && DECL_NAME (method) != finit_identifier_node)
-    {
-      /* NAME is just the plain name when Object is being defined */
-      if (DECL_CONTEXT (method) != object_type_node)
-	DECL_NAME (method) = (DECL_CONSTRUCTOR_P (method) ? 
