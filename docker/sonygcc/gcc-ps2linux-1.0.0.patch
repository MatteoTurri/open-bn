+__SIZE_TYPE__ newsize = 0;
+__SIZE_TYPE__ delsize = 0;
+
+struct A {
+  int i;
+  void * operator new [] (__SIZE_TYPE__ i)
+    { newsize = i; return ::operator new [](i); }
