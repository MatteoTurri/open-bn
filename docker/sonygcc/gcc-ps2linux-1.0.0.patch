+/* On the R5900, we must ensure that the compiler never generates loops
+   that satisfy all of the following conditions:
+   
+   * a loop consists of less than equal to six instructions(includes
+     branch delay slot).
+   
+   * a loop contains only one conditional branch instruction at the
+     end of the loop.
+     
+   * a loop does not contain any other branch or jump instructions.
+
+   * a branch delay slot of the loop is not nop. ( EE#2.9 or later )
+
+   We need to do this because of a bug in the chip.
+
+   */
+/* turn FILL_BDSLOT_WITH_NOP on for EE#2.9 or later */
+#define FILL_BDSLOT_WITH_NOP
+
+#ifdef FILL_BDSLOT_WITH_NOP
+inline
+static int is_nop_insn(insn)
+	rtx insn;
+{
+	return (rtx_equal_p (insn, gen_nop ()));
+}
+#endif
+
+enum sequence_type {Jump, Reset, Otherwise};
+
+/* Detect if possible loop jump presents in the sequence */
+static enum sequence_type 
+detect_sequence_type (insn, count_p, jump_insn_p, seen_before, 
+			after_delayed_branch_sched)
+	rtx insn;
+	int *count_p;
+	rtx *jump_insn_p;
+	int *seen_before;
+	int after_delayed_branch_sched;
+{
+      int i;
+      int detect_later=0;
+
+      for (i = 0; i < XVECLEN (PATTERN (insn), 0); i++)
+	{
+	  rtx v_insn;
+	  v_insn = XVECEXP (PATTERN (insn), 0, i);
+	  switch (GET_CODE (v_insn))
+	    {
+	    case CODE_LABEL:
+	      seen_before [INSN_UID (v_insn)] = *count_p;
+	      break;
+	    case INSN:
+	      /* The attr_length may be bigger than acctual insn length.
+	    	 So don't use it in the after_delayed_branch_sched phase. */
+	      *count_p  += ( get_attr_length (insn) > 0 
+	            		&& !after_delayed_branch_sched ) 
+			    ?  get_attr_length (insn) : 1 ; 
+	      if (detect_later) {
+		/* inspect BD slot */
+#ifdef FILL_BDSLOT_WITH_NOP
+		if (is_nop_insn (PATTERN (v_insn)))
+	            return  Reset;
+#endif
+	        return  Jump;
+	      }
+	      break;
+	    case JUMP_INSN:
+	      *jump_insn_p = v_insn;
+	      detect_later = 1;
+	      break;
+	    case CALL_INSN:
+	      return  Reset;
+	      break;
+	    }
+	}
+      if (detect_later) 
+        {
+	  /* No insn presents in BD slot. AS will fill it with nop. */
+	  return  Reset;
+        }
+      return Otherwise;
+}
