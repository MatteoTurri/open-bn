+// Subject: g++ 2.4.5: assignment operator in base class
+// Date: Mon, 30 Aug 1993 00:54:29 GMT
+
+class B {
+public:
+	B &	operator = (B);	// delete this line and problem goes away
+};
+
+class D : public B {
+public:
+	D();
+	D(int);
+	D(B);
+};
+
+int
+main() {
+	B	b;
+	D	d;
+
+	d = d;
+
