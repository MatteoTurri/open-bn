diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.eh/new1.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.eh/new1.C
--- gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.eh/new1.C	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.eh/new1.C	Mon May 24 18:22:17 1999
@@ -0,0 +1,44 @@
+// Test that a throw in foo destroys the A, but does not free the memory.
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <new.h>
+
+struct A {
+  A();
+  ~A();
+};
+
+struct B {
+  B (A);
+};
+
+void foo (B*);
+
+int newed, created;
+
+int main ()
+{
+  try {
+    foo (new B (A ()));
+  } catch (...) { }
+
+  return !(newed && !created);
+}
+
+A::A() { created = 1; }
+A::~A() { created = 0; }
+B::B(A) { }
+void foo (B*) { throw 1; }
+
+void* operator new (size_t size) throw (std::bad_alloc)
+{
+  ++newed;
+  return (void *) malloc (size);
+}
+
+void operator delete (void *p) throw ()
+{
+  --newed;
+  free (p);
+}
diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/g++.old-deja/g++.eh/new2.C gcc-2.95.2.current/gcc/testsuite/g++.old-deja/g++.eh/new2.C
