diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej gcc-2.95.2/gcc/testsuite/gcc.c-torture/unsorted/ac.c gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/unsorted/ac.c
--- gcc-2.95.2/gcc/testsuite/gcc.c-torture/unsorted/ac.c	Thu Jan  1 09:00:00 1970
+++ gcc-2.95.2.current/gcc/testsuite/gcc.c-torture/unsorted/ac.c	Wed May 19 22:14:49 1999
@@ -0,0 +1,30 @@
+barfoo (a)
+{
+  return (a << 16) & ~0xffff;
+}
+
+foobar (a)
+{
+  return ((unsigned short) a) << 15;}
+
+foo (a)
+{
+  return (a & 0x121) << 31;
+}
+
+bar (a)
+{
+  return (a & ~0xffff) << 16;
+}
+
+main ()
+{
+  int a;
+
+  for (a = 1;  a; a += a)
+    {
+      printf ("%d", (foo (a)));
+    }
+  puts ("");
+}
+
