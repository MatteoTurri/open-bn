diff -uNr --exclude=CVS --exclude=.cvsignore --exclude *.orig --exclude *.rej binutils-2.9EE/gprof/mips.c binutils-2.9EE.current/gprof/mips.c
--- binutils-2.9EE/gprof/mips.c	Thu Jan  1 09:00:00 1970
+++ binutils-2.9EE.current/gprof/mips.c	Tue Nov  9 22:11:14 1999
@@ -0,0 +1,164 @@
