+
+/* Set the format of a file being written.  */
+
+static boolean
+evax_mkobject (abfd)
+     bfd *abfd;
+{
+#if EVAX_DEBUG
+  evax_debug (1, "evax_mkobject(%p)\n", abfd);
+#endif
+
+  if (!evax_initialize (abfd))
+    return 0;
+
+  {
+    const bfd_arch_info_type *arch = bfd_scan_arch ("alpha");
+    if (arch == 0)
+      {
+	bfd_set_error(bfd_error_wrong_format);
+	return 0;
+      }
+    abfd->arch_info = arch;
+  }
+
+  return true;
+}
