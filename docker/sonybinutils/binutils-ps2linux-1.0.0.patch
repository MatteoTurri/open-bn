+/* Remove a section and return whether the corresponding dynsym removed */
+
+boolean mips_elf_remove_section_hook(
+  bfd *output_bfd,
+  asection *sec, 
+  bfd_size_type *backend_added_dynsyms,
+  struct bfd_link_info *info
+  )
+{
+  bfd *dynobj;
+  struct mips_got_info *g;
+  asection *sgot;
+  int gotent_nr;
+
+  int vindx;
+  asection *ss;
+
+  /* adjust dynsymcount */
+  -- (elf_hash_table (info)->dynsymcount);
+  -- *backend_added_dynsyms;
+
+  /* adjust local dynsyms's dynindx */
+  vindx = elf_section_data (sec->output_section)->dynindx;
+  for (ss = output_bfd->sections; ss != NULL; ss = ss->next)
+    {
+    if (elf_section_data (ss)->dynindx > vindx)
+      -- elf_section_data (ss)->dynindx;
+    }
+
+  /* adjust global_gotsym */
+  dynobj = elf_hash_table (info)->dynobj;
+  sgot = bfd_get_section_by_name (dynobj, ".got");
+  if (!sgot)
+        return true;
+  g = (struct mips_got_info *) elf_section_data (sgot)->tdata;
+  g->global_gotsym --;
+
+  /* local dynsym removed */
+  return true;
+}
