+static int is_jump(insn)
+	unsigned long insn;
+{
+	unsigned long op, subop;
+	int jump =0;
+	op = insn >> 26;
+
+	switch (op) {
+	  case	16: /* cop0 */
+	  case	17: /* cop1 */
+	  case	18: /* cop2 */
+		subop = insn >> 21; subop &= 0x1f;
+		if ( subop != 8 ) { 
+			break;
+		};
+		/* bc?f, bc?t, bc?fl, bc?tl */
+		/* fall through */
+	  case	 1 : /* branch or trap */
+	  case	 2 : /* j xx */
+	  case	 3 : /* jal xx */
+	  case	 4 : /* beq s,t, xx */
+	  case	 5 : /* bne s,t, xx */
+	  case	 6 : /* blez s,t, xx */
+	  case	 7 : /* bgtz s,t, xx */
+	  case	20 : /* beql s,t, xx */
+	  case	21 : /* bnezl/bnel */
+	  case	22 : /* blezl s, xx */
+	  case	23 : /* bgtzl s, xx */
+		jump ++;
+		break;
+	  case 0:
+		subop = insn & 0x3f;
+		if ( subop != 8  /* jr */
+		  && subop != 9  /* jalr */
+		  && subop != 15 /* sync */ ) 
+			break;
+		jump ++;
+		break;
+
+	}
+	return jump;
+}
