+/*
+ * Dynamic string garbage collector
+ */
+
+extern char *
+_bfd_stringtab_string_by_strindx (
+     struct bfd_strtab_hash *tab,
+     bfd_size_type strindx
+);
+
+#ifndef DT_MIPS_IVERSION
+#define DT_MIPS_IVERSION 0x70000004
+#endif
+static
+boolean record_dot_dynamic_str(asvinfo, old_dynstr)
+  struct elf_assign_sym_version_info *asvinfo;
+  struct bfd_strtab_hash *old_dynstr;
+{
+  Elf_External_Dyn *dyncon, *dynconend;
+  struct bfd_strtab_hash *dynstr;
+  bfd *dynobj;
+  asection *sdyn;
+  struct bfd_link_info *info = asvinfo->info;
+  bfd *abfd = asvinfo->output_bfd;
+  bfd_size_type indx;
+  char *name;
+
+  dynobj = elf_hash_table (info)->dynobj;
+  sdyn = bfd_get_section_by_name (dynobj, ".dynamic");
+  if (!sdyn)
+    return true;
+
+  dynstr = elf_hash_table (info)->dynstr;
+  dyncon = (Elf_External_Dyn *) sdyn->contents;
+  dynconend = (Elf_External_Dyn *) (sdyn->contents + sdyn->_raw_size);
+  for (; dyncon < dynconend; dyncon++)
+    {
+      Elf_Internal_Dyn dyn;
+
+      elf_swap_dyn_in (elf_hash_table (info)->dynobj, dyncon, &dyn);
+      switch (dyn.d_tag)
+        {
+        case DT_MIPS_IVERSION:
+        case DT_NEEDED:
+        case DT_SONAME:
+        case DT_RPATH:
+        case DT_FILTER:
+        case DT_AUXILIARY:
+            name = _bfd_stringtab_string_by_strindx(old_dynstr, 
+	                     (bfd_size_type)dyn.d_un.d_val);
+            if (name)
+              indx = _bfd_stringtab_add (dynstr, name, true, true);
+            else
+              indx = 0;
+            dyn.d_un.d_val = indx;
+            elf_swap_dyn_out (elf_hash_table (info)->dynobj, &dyn, dyncon);
+            break;
+
+        default:
+            break;
+	}
+    }
+  return true;
+}
+
+static
+boolean record_dot_gnu_dot_version_r_str(asvinfo, old_dynstr)
+  struct elf_assign_sym_version_info *asvinfo;
+  struct bfd_strtab_hash *old_dynstr;
+{
+  Elf_Internal_Verneed *t;
+  struct bfd_strtab_hash *dynstr;
+  bfd *dynobj;
+  asection *s;
+  struct bfd_link_info *info = asvinfo->info;
+  bfd *abfd = asvinfo->output_bfd;
+  bfd_size_type indx;
+  char *name;
+  bfd_byte *p;
+
+  dynobj = elf_hash_table (info)->dynobj;
+  s = bfd_get_section_by_name (dynobj, ".gnu.version_r");
+  if (!s)
+    return true;
+
+  dynstr = elf_hash_table (info)->dynstr;
+  p = s->contents;
+
+  for (t = elf_tdata (abfd)->verref;
+       t != NULL;
+       t = t->vn_nextref)
+     {
+      Elf_Internal_Vernaux *a;
+      Elf_Internal_Verneed verneed;
+      Elf_Internal_Vernaux veraux;
+
+      _bfd_elf_swap_verneed_in (abfd,
+                          (Elf_External_Verneed *)p, &verneed);
+      name = _bfd_stringtab_string_by_strindx(old_dynstr, 
+	                     (bfd_size_type)verneed.vn_file);
+      if (name)
+        indx = _bfd_stringtab_add (dynstr, name, true, true);
+      else
+        indx = 0;
+      verneed.vn_file = indx;
+
+      _bfd_elf_swap_verneed_out (abfd, &verneed,
+                          (Elf_External_Verneed *)p);
+      p += sizeof (Elf_External_Verneed);
+
+      for (a = t->vn_auxptr; a != NULL; a = a->vna_nextptr)
+        {
+          _bfd_elf_swap_vernaux_in (abfd,
+                                      (Elf_External_Vernaux *) p, &veraux);
+          name = _bfd_stringtab_string_by_strindx(old_dynstr, 
+	                     (bfd_size_type)veraux.vna_name);
+          if (name)
+            indx = _bfd_stringtab_add (dynstr, name, true, true);
+          else
+            indx = 0;
+          veraux.vna_name = indx;
+
+          _bfd_elf_swap_vernaux_out (abfd, &veraux,
+                                        (Elf_External_Vernaux *) p);
+           p += sizeof (Elf_External_Vernaux);
+
+        }
+     }
+
+  return true;
+}
+
+static
+boolean record_dot_gnu_dot_version_d_str(asvinfo, old_dynstr)
+  struct elf_assign_sym_version_info *asvinfo;
+  struct bfd_strtab_hash *old_dynstr;
+{
+  struct bfd_elf_version_tree *verdefs;
+  bfd_byte *p;
+  struct bfd_strtab_hash *dynstr;
+  bfd *dynobj;
+  asection *s;
+  struct bfd_link_info *info = asvinfo->info;
+  bfd *abfd = asvinfo->output_bfd;
+  Elf_Internal_Verdef def;
+  Elf_Internal_Verdaux defaux;
+  struct bfd_elf_version_deps *n;
+  struct bfd_elf_version_tree *t;
+  bfd_size_type indx;
+  char *name;
+
+  verdefs = asvinfo->verdefs;
+
+  dynobj = elf_hash_table (info)->dynobj;
+  s = bfd_get_section_by_name (dynobj, ".gnu.version_d");
+  if (!s)
+    return true;
+
+  dynstr = elf_hash_table (info)->dynstr;
+  p = s->contents;
+  if (p==0)
+    return true;
+
+  _bfd_elf_swap_verdef_in (abfd, (Elf_External_Verdef *) p, &def);
+  p += sizeof (Elf_External_Verdef);
+
+  _bfd_elf_swap_verdaux_in (abfd, (Elf_External_Verdaux *) p, &defaux);
+  if (defaux.vda_name) 
+    {
+      name = _bfd_stringtab_string_by_strindx(old_dynstr, 
+	                     (bfd_size_type)defaux.vda_name);
+      if (name)
+        indx = _bfd_stringtab_add (dynstr, name, true, true);
+      else
+        indx = 0;
+      defaux.vda_name = indx;
+
+      _bfd_elf_swap_verdaux_out (abfd, &defaux,
+                                (Elf_External_Verdaux *) p);
+
+    } 
+  p += sizeof (Elf_External_Verdaux);
+
+  for (t = verdefs; t != NULL; t = t->next)
+    {
+
+      _bfd_elf_swap_verdef_in (abfd, (Elf_External_Verdef *) p, &def);
+      p += sizeof (Elf_External_Verdef);
+
+      _bfd_elf_swap_verdaux_in (abfd, (Elf_External_Verdaux *) p, &defaux);
+      if (defaux.vda_name) 
+        {
+          name = _bfd_stringtab_string_by_strindx(old_dynstr, 
+	                     (bfd_size_type)defaux.vda_name);
+          if (name)
+            indx = _bfd_stringtab_add (dynstr, name, true, true);
+          else
+	    indx = 0;
+          defaux.vda_name = indx;
+
+          _bfd_elf_swap_verdaux_out (abfd, &defaux,
+	                                (Elf_External_Verdaux *) p);
+
+        }
+      p += sizeof (Elf_External_Verdaux);
+
+      for (n = t->deps; n != NULL; n = n->next)
+        {
+          _bfd_elf_swap_verdaux_in (abfd, (Elf_External_Verdaux *) p, &defaux);
+
+          if (defaux.vda_name) 
+	    {
+	      name = _bfd_stringtab_string_by_strindx(old_dynstr, 
+	                     (bfd_size_type)defaux.vda_name);
+	      if (name)
+                indx = _bfd_stringtab_add (dynstr, name, true, true);
+              else
+	        indx = 0;
+              defaux.vda_name = indx;
+
+              _bfd_elf_swap_verdaux_out (abfd, &defaux,
+	                                  (Elf_External_Verdaux *) p);
+
+	    }
+          p += sizeof (Elf_External_Verdaux);
+        }
+    }
+
+  return true;
+}
+
+static
+boolean
+record_dot_dynsym_str (h, info)
+     struct elf_link_hash_entry *h;
+     struct bfd_link_info *info;
+{
+  struct bfd_strtab_hash *dynstr;
+  char *p, *alc;
+  const char *name;
+  boolean copy;
+  boolean is_local;
+  bfd_size_type indx;
+
+  dynstr = elf_hash_table (info)->dynstr;
+
+  if (h->dynindx == -1)
+    return true;
+
+  is_local = ((h->elf_link_hash_flags & ELF_LINK_FORCED_LOCAL) != 0);
+
+  if (is_local)
+    {
+      h->dynstr_index = 0;
+      return true;
+    }
+
+  /* We don't put any version information in the dynamic string table.  */
+  name = h->root.root.string;
+  p = strchr (name, ELF_VER_CHR);
+  if (p == NULL)
+    {
+      alc = NULL;
+      copy = false;
+    }
+  else
+    {
+      alc = alloca (p - name + 1);
+      strncpy (alc, name, p - name);
+      alc[p - name] = '\0';
+      name = alc;
+      copy = true;
+    }
+
+  indx = _bfd_stringtab_add (dynstr, name, true, copy);
+  if (indx == (bfd_size_type) -1)
+    return false;
+
+  h->dynstr_index = indx;
+
+  return true;
+}
+
+static
+boolean
+elf_bfd_link_gc_dynstr(asvinfo)
+  struct elf_assign_sym_version_info *asvinfo;
+{
+  struct bfd_link_info *info = asvinfo->info;
+  struct bfd_strtab_hash *old_dynstr;
+  struct bfd_strtab_hash *new_dynstr;
+
+  old_dynstr = elf_hash_table (info)->dynstr;
+  if (old_dynstr == NULL)
+    return true; 
+
+  /* Create a strtab to hold the new dynamic symbol names.  */
+  new_dynstr = _bfd_elf_stringtab_init ();
+  if (new_dynstr == NULL)
+    return false;
+
+  elf_hash_table (info)->dynstr = new_dynstr;
+
+  if (!record_dot_dynamic_str(asvinfo, old_dynstr))
+    return false;
+
+  if (!record_dot_gnu_dot_version_r_str(asvinfo, old_dynstr))
+    return false;
+
+  if (!record_dot_gnu_dot_version_d_str(asvinfo, old_dynstr))
+    return false;
+
+  _bfd_stringtab_free (old_dynstr);
+
+  elf_link_hash_traverse (elf_hash_table (info),
+                            record_dot_dynsym_str,
+                            (PTR) info);
+  return true; 
 }
