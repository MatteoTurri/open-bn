+  info = ((struct fl_info *)p)->info;
+  if ((h->dynindx == -1) && 
+  	(h->elf_link_hash_flags & ELF_LINK_FORCED_LOCAL) !=0  &&
+  	(h->elf_link_hash_flags & ELF_LINK_HASH_DEF_REGULAR) !=0 &&
+  	(refered))
