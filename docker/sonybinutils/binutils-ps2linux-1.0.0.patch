+  if (abfd->section_count > 0)			/* we have sections */
+    {
+      if (_bfd_evax_write_emh (abfd) != 0)
+	return false;
+      if (_bfd_evax_write_egsd (abfd) != 0)
+	return false;
+      if (_bfd_evax_write_etir (abfd) != 0)
+	return false;
+      if (_bfd_evax_write_etbt (abfd) != 0)
+	return false;
+      if (_bfd_evax_write_eeom (abfd) != 0)
+	return false;
+    }
+  return true;
+}
