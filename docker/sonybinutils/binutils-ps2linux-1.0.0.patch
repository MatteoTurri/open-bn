+static boolean 
+mips_elf_renumber_dynsyms_hook (output_bfd, backend_added_dynsyms, info)
+    bfd *output_bfd; 
+    bfd_size_type *backend_added_dynsyms;
+    struct bfd_link_info *info;
+{
+  bfd *dynobj;
+  struct mips_got_info *g;
+  asection *sgot;
+  int gotent_nr;
+  struct fl_info fl_info;
+  unsigned int forced_locals;
+  bfd_size_type dynsymcount;
+
+  dynobj = elf_hash_table (info)->dynobj;
+  sgot = bfd_get_section_by_name (dynobj, ".got");
+  if (!sgot)
+  	return true;
+  g = (struct mips_got_info *) elf_section_data (sgot)->tdata;
+
+  g->global_gotsym = 0;
+
+  /* BEGIN: support forced-local */
+
+  /* Reorder dynsyms */
+
+  /* count forced-locals */
+  fl_info.got_info = g;
+  fl_info.info = info;
+  fl_info.record = false;
+  fl_info.count = 0;
+#ifdef SHURINK_FORCED_LOCAL_GOT
+  fl_info.target = both;
+#endif
+  elf_link_hash_traverse (elf_hash_table (info),
+	  adjust_forced_local_gotsym, (PTR) &fl_info);
+  forced_locals = fl_info.count;
+
+  /* make a hole for forced-locals */
+  elf_link_hash_traverse (elf_hash_table (info),
+			    mips_elf_adjust_dynindx,
+				    (PTR) &forced_locals);
+  dynsymcount = elf_hash_table (info)->dynsymcount + forced_locals;
+
+#ifdef SHURINK_FORCED_LOCAL_GOT
+  /* insert forced-locals having no got entry into the hole */
+  elf_hash_table (info)->dynsymcount = 1 + *backend_added_dynsyms;
+  fl_info.got_info = g;
+  fl_info.info = info;
+  fl_info.record = true;
+  fl_info.count = 0;
+  fl_info.target = nongot;
+  elf_link_hash_traverse (elf_hash_table (info),
+	  adjust_forced_local_gotsym, (PTR) &fl_info);
+
+  g->global_gotsym = fl_info.count;
+  
+  /* insert forced-locals having got entry into the hole */
+  fl_info.got_info = g;
+  fl_info.info = info;
+  fl_info.record = true;
+  fl_info.count = 0;
+  fl_info.target = got;
+  elf_link_hash_traverse (elf_hash_table (info),
+	  adjust_forced_local_gotsym, (PTR) &fl_info);
+#else
+  /* insert forced-locals into the hole */
+  elf_hash_table (info)->dynsymcount = 1 + *backend_added_dynsyms;
+  fl_info.got_info = g;
+  fl_info.info = info;
+  fl_info.record = true;
+  fl_info.count = 0;
+  elf_link_hash_traverse (elf_hash_table (info),
+	  adjust_forced_local_gotsym, (PTR) &fl_info);
+
+#endif
+
+  elf_hash_table (info)->dynsymcount = dynsymcount;
+
+  /* END: support forced-local */
+
+
+  /* adjust g->global_gotsym */
+  g->global_gotsym += *backend_added_dynsyms + 1;
+
+  gotent_nr = elf_hash_table (info)->dynsymcount - g->global_gotsym;
+  gotent_nr = (gotent_nr>1) ? gotent_nr : 1;
+  gotent_nr += g->local_gotno;	/* local_got */
+
+  if (!(sgot->_raw_size >= (gotent_nr*4)))
+    {
+      (*_bfd_error_handler) 
+        (_( "mips_elf_renumber_dynsyms_hook: GOT table overflow:"
+	   "section size:%d gotent_nr:%d dynsymcount:%d "
+	   "local_gotno:%d  global_gotsym:%d\n"),
+	   (int) sgot->_raw_size,
+	   (int) gotent_nr,
+	   (int) (elf_hash_table (info)->dynsymcount),
+	   (int) g->local_gotno,
+	   (int) g->global_gotsym);
+      abort();
+    }
+  
+  if (sgot->_raw_size != (gotent_nr*4))
+	sgot->_raw_size = gotent_nr*4;
+
+  return true;
+
+}
