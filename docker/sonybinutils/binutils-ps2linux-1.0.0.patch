+int
+dump_mips_got(FILE *file)
+{
+  Elf32_Internal_Shdr *    section;
+  Elf32_Internal_Shdr *    got_section = 0;
+
+  int		  dynstr_size = 0;
+  int i;
+  int             bytes;
+  int             addr;
+  unsigned char * data;
+  unsigned char * start;
+  int ent;
+  char *name=0;
+  int wordsize;
+
+  if (binary_class == ELFCLASS32)
+    wordsize = 4;
+  else
+    wordsize = 8;
+
+  for (i = 0, section = section_headers;
+       i < elf_header.e_shnum;
+       i ++, section ++)
+    {
+      name = SECTION_NAME (section);
+      if (section->sh_type == SHT_STRTAB
+	       && strcmp (name, ".dynstr") == 0)
+	dynstr_size = section->sh_size;
+      else if ( !strcmp(name, ".got"))
+	got_section = section;
+    }
+  if ( got_section == 0 )
+    return 0;
+
+  bytes = got_section->sh_size;
+
+  if (bytes == 0)
+    {
+      printf (_("\nSection '%s' has no data to dump.\n"),
+	      SECTION_NAME (got_section));
+      return 0;
+    }
+  else
+    printf (_("\nDump of MIPS Global Offset Table '%s':\n"), SECTION_NAME (got_section));
+
+
+  printf(" %4s  %6s   %10s ", "Ent#","Gp Off", "Addr"); 
+  if (wordsize==4)
+    printf("   %4s ", "Value");
+  else
+    printf("   %8s ", "Value");
+
+  printf("DynSym [Ent#, Val, Name]\n");
+
+  addr = got_section->sh_addr;
+  GET_DATA_ALLOC (got_section->sh_offset, bytes, start, unsigned char *,
+		  "section data");
+
+  data = start;
+  ent = 0;
+  while (bytes)
+    {
+      int j;
+      int k;
+      int lbytes;
+
+      lbytes = (bytes > wordsize ? wordsize : bytes);
+
+      printf (" %4d ", ent);
+      printf (" %6d ", -32752+ent*wordsize);
+      printf ("  0x%8.8x ", addr);
+
+      switch (elf_header.e_ident [EI_DATA])
+	{
+	case ELFDATA2LSB:
+	  for (j = (wordsize-1); j >= 0; j --)
+	    {
+	      if (j < lbytes)
+		printf ("%2.2x", data [j]);
+	      else
+		printf ("  ");
+	    }
+	  break;
+
+	case ELFDATA2MSB:
+	  for (j = 0; j < wordsize; j++)
+	    {
+	      if (j < lbytes)
+		printf ("%2.2x", data [j]);
+	      else
+		printf ("  ");
+	    }
+	  break;
+	}
+
+      if ( ent<mips_local_gotno) {
+	printf (" (local) ");
+      }
+      else {
+	int kk;
+	kk  = ent -  mips_local_gotno +mips_gotsym;
+	
+        if (kk< mips_dyn_symtab_nr) 
+          {
+	    printf (" [%4d 0x%8.8x", kk, dynamic_symbols[kk].st_value);
+	    if ( dynamic_symbols[kk].st_name < dynstr_size )
+	      printf(" %s", dynamic_strings + dynamic_symbols[kk].st_name);
+	    else 
+	      printf(" (invalid offset %d)", dynamic_symbols[kk].st_name);
+	    printf(" ]");
+          } 
+        else
+	  printf(" (no dyn_symtab)");
+      }
+
+      putchar ('\n');
+      ent ++;
+
+      data  += lbytes;
+      addr  += lbytes;
+      bytes -= lbytes;
+    }
+
+  free (start);
+
+  return 1;
+}
+#endif
