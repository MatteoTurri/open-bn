+/* Lookup by strindx */
+char *
+_bfd_stringtab_string_by_strindx (tab, strindx)
+     struct bfd_strtab_hash *tab;
+     bfd_size_type strindx;
+{
+  register struct strtab_hash_entry *entry;
+
+  for (entry = tab->first; entry != NULL; entry = entry->next)
+    {
+        if (entry->index == strindx) break;
+    }
+  if (entry==NULL)
+    return (char *)0;
+
+  return (char *)entry->root.string;
+}
